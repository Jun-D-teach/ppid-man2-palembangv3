# ==============================================================================
# ENVIRONMENT VARIABLES FOR DEPLOYMENT (HOSTINGER / VPS / PRODUCTION)
# ==============================================================================

# Port aplikasi backend berjalan (Default: 3000)
PORT=3000

# Environment Mode: 'production' atau 'development'
# Di Hostinger/Production, atur ini ke 'production'
NODE_ENV=production

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Set ke 'true' untuk menggunakan database MySQL asli (Hostinger)
# Jika dikosongkan atau 'false', aplikasi akan otomatis menggunakan database mockup (db.json)
USE_REAL_DB=true

# Host dari Database MySQL (Contoh di Hostinger: 'localhost' atau alamat host MySQL dari panel Hostinger)
DB_HOST=localhost

# Username Database MySQL yang dibuat di panel Hostinger
DB_USER=u471136757_user

# Password Database MySQL yang dibuat di panel Hostinger
DB_PASSWORD=PasswordDatabaseAnda123!

# Nama Database MySQL yang dibuat di panel Hostinger (Misalnya: u471136757_ppid_mandupa26)
DB_NAME=u471136757_ppid_mandupa26

# Batasan koneksi database MySQL (Default: 10)
DB_CONNECTION_LIMIT=10

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================

# Kunci rahasia JWT untuk login Admin PPID (Gantilah dengan string acak dan panjang untuk keamanan produksi!)
JWT_SECRET=GantiIniDenganStringRahasiaYangSangatPanjangDanAcak123!

# Durasi masa aktif login admin (Contoh: '1d' = 1 hari, '7d' = 7 hari)
JWT_EXPIRES_IN=1d

# Jumlah enkripsi salt rounds untuk password hashing (Default: 10)
BCRYPT_SALT_ROUNDS=10

# ==============================================================================
# ORIGIN & CORS (CROSS-ORIGIN RESOURCE SHARING)
# ==============================================================================

# URL dari frontend utama yang diizinkan mengakses API (dipisahkan tanda koma jika lebih dari satu)
# Contoh: http://domain-ppid.com,https://domain-ppid.com
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# FILE UPLOAD LIMITATION
# ==============================================================================

# Batasan ukuran file maksimal yang bisa di-upload dalam satuan Byte (Default: 10MB / 10 * 1024 * 1024)
MAX_UPLOAD_SIZE=10485760

# Tipe file (MIME types) yang diizinkan untuk di-upload, dipisahkan tanda koma
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/csv
